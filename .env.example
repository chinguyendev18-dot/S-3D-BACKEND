# S-3D BACKEND (NestJS) — nơi DUY NHẤT giữ khoá bí mật của hệ thống.
# Bản thật: .env (không commit). Trên server: đặt trong biến môi trường của host.

# ---- Máy chủ
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Các trang được gọi API (web, admin, xưởng, Expo web).
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8081
# Proxy được tin để lấy IP khách (X-Forwarded-For): loopback = web/admin/xưởng chạy cùng máy;
# sau load balancer thì ghi số tầng proxy (vd 1) hoặc dải IP của proxy.
TRUST_PROXY=loopback
# Địa chỉ API mà trình duyệt / app thấy (để tạo link file công khai khi chưa có R2_PUBLIC_URL).
PUBLIC_API_URL=http://localhost:4000/api/v1
# Trang tài liệu API /api/v1/docs: mặc định bật khi không phải production; false để tắt hẳn.
API_DOCS=
# Khoá ký vé realtime (socket.io), >= 32 ký tự. Để trống: tự sinh mỗi lần chạy (đủ khi chỉ có 1 server).
REALTIME_SECRET=

# ---- Supabase PostgreSQL (Supabase > Project Settings > Database > Connect)
# Chuỗi "Transaction pooler" (cổng 6543) — dùng khi chạy.
DATABASE_URL=
# Chuỗi "Session pooler" hoặc "Direct" (cổng 5432) — dùng cho prisma migrate.
DIRECT_URL=

# ---- Supabase Auth (Project Settings > API Keys)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... — BÍ MẬT, chỉ backend được giữ.
SUPABASE_SECRET_KEY=

# ---- Cloudflare R2 (R2 > Manage API tokens, quyền Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=s3d-files
# Bucket mở công khai cho ảnh (sản phẩm, blog, avatar). R2 mở cả bucket một lúc, nên file riêng tư ở R2_BUCKET.
# Để trống: dùng chung R2_BUCKET (khi đó KHÔNG được bật public cho R2_BUCKET).
R2_PUBLIC_BUCKET=
# Tên miền công khai của bucket (ảnh sản phẩm). File riêng (mô hình, ảnh đổi trả) dùng link có hạn.
R2_PUBLIC_URL=
# Link có hạn sống bao nhiêu giây.
R2_SIGNED_URL_TTL=900

# ---- Firebase Admin (Project settings > Service accounts > Generate new private key)
# Lấy 3 trường project_id, client_email, private_key trong file JSON tải về.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Giữ nguyên dấu ngoặc kép và các \n.
FIREBASE_PRIVATE_KEY=
